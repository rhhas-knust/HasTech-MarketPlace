# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses Row Level Security -- never expose this to the
# browser or commit it. See src/lib/supabase/admin.ts for where it's used.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: direct Postgres connection string, useful for running
# `supabase/migrations/*.sql` with psql or the Supabase CLI outside of the
# Supabase SQL editor. Project Settings -> Database -> Connection string.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- App -------------------------------------------------------------------
# Public base URL of this deployment (used for Paystack callback URLs,
# sitemap.xml, Open Graph tags, etc). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Payments (Paystack) ---------------------------------------------------
# NOTE: There are no PAYSTACK_* environment variables. This is a
# multi-tenant platform -- each seller connects their OWN Paystack account
# from their dashboard (Settings -> Payments), so payments go directly to
# them, not through a shared platform account. Those keys are stored in the
# store_payment_credentials table (service-role access only; see
# supabase/migrations/0010_rls_policies.sql) rather than as env vars.
# Use Paystack TEST keys during development -- never live keys.
