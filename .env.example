# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses Row Level Security -- never expose this to the
# browser or commit it. See src/lib/supabase/admin.ts for where it's used.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: direct Postgres connection string, useful for running
# `supabase/migrations/*.sql` with psql or the Supabase CLI outside of the
# Supabase SQL editor. Project Settings -> Database -> Connection string.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- App -------------------------------------------------------------------
# Public base URL of this deployment (used for Paystack callback URLs,
# sitemap.xml, Open Graph tags, etc). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Payments (Paystack) ---------------------------------------------------
# Each seller connects their OWN Paystack account from their dashboard
# (Settings -> Payments) for their storefront checkout -- those keys are
# stored in the store_payment_credentials table (service-role access only;
# see supabase/migrations/0010_rls_policies.sql), never as env vars.
#
# PAYSTACK_PLATFORM_SECRET_KEY is different: it's HASTECH's OWN Paystack
# account, used only for platform billing (seller subscriptions/commission
# settlements, see src/lib/payments/platform.ts and
# supabase/migrations/0016_platform_billing.sql), never for a seller's own
# customer-facing checkout. Use a Paystack TEST key during development --
# never a live key, and never commit a real value here.
PAYSTACK_PLATFORM_SECRET_KEY=sk_test_your-platform-secret-key

# --- Email (Resend) ----------------------------------------------------------
# Order-confirmation (customer) and new-order-alert (seller) emails, see
# src/lib/email.ts. RESEND_API_KEY alone is enough to send during
# development -- Resend's shared "onboarding@resend.dev" sender (the
# default for EMAIL_FROM below) can only deliver to the email address on
# your OWN Resend account, so real customers/sellers won't receive
# anything until a domain you control is added and verified in Resend and
# EMAIL_FROM is set to an address on it. Missing RESEND_API_KEY doesn't
# break anything -- sendEmail() just logs and skips.
RESEND_API_KEY=re_your-api-key
EMAIL_FROM=HASTECH Commerce <onboarding@resend.dev>

# Encrypts sellers' Paystack secret keys at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
PAYMENT_CREDENTIALS_KEY=

# Vercel Cron sends this as a Bearer token to /api/cron/* (any long random string).
CRON_SECRET=
